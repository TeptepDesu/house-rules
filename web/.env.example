# Copy to .env.local. Never commit real values.
# Everything here is optional for local dev: with no .env.local the app uses an in-process
# PGlite database (web/.data/pglite) and a dev-only session secret.

# Any hosted Postgres (Neon, Supabase, RDS, …). Unset = PGlite. Required in production.
DATABASE_URL=

# ≥32 random chars, e.g. `openssl rand -base64 48`. Unset = dev-only fallback. Required in production.
SESSION_SECRET=

# testnet | mainnet
NEAR_NETWORK=testnet
