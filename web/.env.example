# Copy to .env.local. Never commit real values.
# Everything here is optional for local dev: with no .env.local the app uses an in-process
# PGlite database (web/.data/pglite) and a dev-only session secret.

# Any hosted Postgres (Neon, Supabase, RDS, …). Unset = PGlite. Required in production.
DATABASE_URL=

# ≥32 random chars, e.g. `openssl rand -base64 48`. Unset = dev-only fallback. Required in production.
SESSION_SECRET=

# testnet | mainnet
NEAR_NETWORK=testnet

# Guest payments via NEAR Intents 1Click. mock (default outside production) | live
ONECLICK_MODE=mock
# Optional; without a key 1Click charges 0.2%. Server-only, never NEXT_PUBLIC_.
ONECLICK_API_KEY=
# live mode only — confirm all three in spike #2 (docs/notes.md):
USDC_ASSET_ID=          # 1Click asset id of USDC on NEAR (nep141:...)
USDC_TOKEN_ACCOUNT=     # NEAR account of the USDC contract
INTENTS_SENDERS=intents.near   # signer(s) of 1Click delivery txs, for on-chain verification
# Optional RPC override
NEAR_RPC_URL=
