{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mts",
    "e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:testnet": "node --env-file=.env.testnet.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts test/integration/agent.testnet.test.ts",
    "break-it": "node --env-file=.env.testnet.local scripts/try-to-break-it.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.13",
    "@hot-labs/near-connect": "0.12.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.65.0",
    "near-api-js": "7.4.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
